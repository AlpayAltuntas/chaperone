{
  "name": "@alpay_altuntas/chaperone",
  "version": "0.1.0",
  "description": "Security scanner that audits self-hosted personal AI agents for OWASP-LLM-mapped security weaknesses.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "chaperone": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlpayAltuntas/chaperone.git"
  },
  "homepage": "https://github.com/AlpayAltuntas/chaperone#readme",
  "bugs": {
    "url": "https://github.com/AlpayAltuntas/chaperone/issues"
  },
  "keywords": [
    "security",
    "scanner",
    "cli",
    "ai-agent",
    "owasp",
    "llm",
    "static-analysis"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.eslint.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
